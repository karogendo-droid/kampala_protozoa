# Keep sequencing data, databases and unreviewed outputs local
/data/
/references/
/results/
/logs/
/tmp/
/downloads/

# Sequence and alignment files, including accidental copies elsewhere
*.fastq
*.fastq.gz
*.fq
*.fq.gz
*.sra
*.fasta
*.fasta.gz
*.fa
*.fa.gz
*.fna
*.fna.gz
*.sam
*.bam
*.bai
*.cram
*.crai

# Credentials and local configuration
.env
.env.*
*.pem
*.key

# macOS and Python temporary files
.DS_Store
__pycache__/
.ipynb_checkpoints/
